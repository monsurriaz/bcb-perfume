{%- doc -%}
  The Great Offer section enables customers to select from tiered bundle options,
  choose scents via a modal, and add multiple variant items to cart at once.
{%- enddoc -%}

{%- assign all_block_products = section.blocks | map: 'settings' | map: 'product' | uniq -%}

<section class="great-offer-section">
  <div class="go-inner">
    <div class="go-header">
      <div class="go-eyebrow">{{ section.settings.eyebrow_text }}</div>
      <h2 class="go-title">{{ section.settings.title }}</h2>
      <p class="go-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="go-cards">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- assign size_option_value = block.settings.size_option_value -%}
        {%- assign qty = block.settings.qty_included -%}
        {%- assign is_featured = block.type == 'featured_offer_card' -%}

        {%- if product -%}
          {%- comment -%} Find the variant matching this size {%- endcomment -%}
          {%- assign size_variant = nil -%}
          {%- for variant in product.variants -%}
            {%- if variant.option1 == size_option_value or variant.option2 == size_option_value or variant.option3 == size_option_value -%}
              {%- assign size_variant = variant -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if size_variant -%}
            {%- comment -%} Build scents array: all products × their size variant {%- endcomment -%}
            {%- assign scents_json_parts = '' -%}
            {%- for prod in all_block_products -%}
              {%- if prod -%}
                {%- for var in prod.variants -%}
                  {%- if var.option1 == size_option_value or var.option2 == size_option_value or var.option3 == size_option_value -%}
                    {%- if scents_json_parts != '' -%}
                      {%- assign scents_json_parts = scents_json_parts | append: ',' -%}
                    {%- endif -%}
                    {%- capture scent_obj -%}
                      {"id": {{ var.id }}, "title": "{{ prod.title | escape }}", "available": {{ var.available | default: false }}}
                    {%- endcapture -%}
                    {%- assign scents_json_parts = scents_json_parts | append: scent_obj -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}

            {%- assign scents_json = '[' | append: scents_json_parts | append: ']' -%}

            <div
              class="go-card{% if is_featured %} go-card--best{% endif %}"
              data-scents='{{ scents_json }}'
              data-qty="{{ qty }}"
              data-size-label="{{ block.settings.size_label }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {%- if is_featured -%}
                <div class="go-best-label">⭐ Best Value by Far</div>
              {%- endif -%}

              <div class="go-size-badge">{{ block.settings.size_label }}</div>
              <div class="go-price">{{ size_variant.price | money }}</div>
              <div class="go-deal-tag{% if is_featured %} go-deal-tag--big{% endif %}">
                {{ block.settings.deal_tag_text }}
              </div>

              <div class="go-divider"></div>

              <div class="go-stat-row">
                <span>Bottles included</span>
                <span>× {{ qty }}</span>
              </div>

              <div class="go-ppm-row">
                <span class="go-ppm-label">{{ block.settings.per_ml_label }}</span>
                <span class="go-ppm-value{% if is_featured %} go-ppm-value--best{% endif %}">
                  {{ block.settings.per_ml_value }}
                </span>
              </div>

              {%- if is_featured and block.settings.saving_text != blank -%}
                <div class="go-saving">{{ block.settings.saving_text }}</div>
              {%- endif -%}

              <button
                class="go-btn{% if is_featured %} go-btn--best{% endif %}"
                type="button"
                data-action="go-start-flow"
              >
                {{ block.settings.btn_text }}
              </button>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Modal -->
    <div class="go-modal" id="go-modal">
      <div class="go-modal-box">
        <button class="go-modal-close" type="button" id="go-modal-close">✕</button>
        <h3 id="go-modal-title">Choose your bottles</h3>
        <p id="go-modal-subtitle" class="go-modal-sub"></p>
        <div class="go-scent-grid" id="go-scent-grid"></div>
        <div class="go-modal-footer">
          <span id="go-selection-count" class="go-sel-count">0 selected</span>
          <button class="go-confirm-btn" id="go-confirm-btn" type="button" disabled>
            Add to cart
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  .great-offer-section {
    --go-gold: #c9a84c;
    --go-gold-light: #e8d499;
    --go-dark: #1a1a1a;
    --go-cream: #faf7f2;
    --go-radius: 18px;
    background: var(--go-cream);
    padding: 70px 24px 80px;
  }

  .go-inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  .go-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .go-eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--go-gold);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    margin-bottom: 14px;
  }

  .go-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 900;
    color: var(--go-dark);
    line-height: 1.1;
    margin-bottom: 14px;
  }

  .go-subtitle {
    font-size: 16px;
    color: #888;
    max-width: 440px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .go-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .great-offer-section .go-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .go-card {
    background: #fff;
    border-radius: var(--go-radius);
    border: 2px solid #e8e0d5;
    padding: 34px 26px 30px;
    text-align: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s;
    position: relative;
  }

  .go-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
  }

  .go-card--best {
    background: var(--go-dark);
    border: 2px solid var(--go-gold);
    color: #fff;
    padding-top: 44px;
    transform: scale(1.04);
    box-shadow: 0 20px 60px rgba(201, 168, 76, 0.22),
      0 4px 16px rgba(0, 0, 0, 0.18);
    z-index: 2;
  }

  .go-card--best:hover {
    transform: scale(1.04) translateY(-6px);
    box-shadow: 0 28px 72px rgba(201, 168, 76, 0.28),
      0 4px 20px rgba(0, 0, 0, 0.22);
  }

  .go-best-label {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, var(--go-gold), #e8c96a);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 5px 18px;
    border-radius: 20px;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(201, 168, 76, 0.4);
  }

  .go-size-badge {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--go-gold);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .go-price {
    font-family: 'Playfair Display', serif;
    font-size: 2.8rem;
    font-weight: 700;
    color: inherit;
    line-height: 1;
    margin-bottom: 6px;
  }

  .go-card:not(.go-card--best) .go-price {
    color: var(--go-dark);
  }

  .go-deal-tag {
    display: inline-block;
    background: #f5f0e8;
    color: #9a8060;
    font-size: 13px;
    padding: 5px 14px;
    border-radius: 20px;
    font-weight: 500;
    margin-bottom: 14px;
  }

  .go-deal-tag--big {
    background: rgba(201, 168, 76, 0.15);
    color: var(--go-gold);
    font-weight: 700;
    font-size: 14px;
    border: 1px solid rgba(201, 168, 76, 0.3);
  }

  .go-divider {
    height: 1px;
    background: #f0ebe3;
    margin: 14px 0;
  }

  .go-card--best .go-divider {
    background: rgba(255, 255, 255, 0.1);
  }

  .go-stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    padding: 4px 0;
    color: #999;
  }

  .go-card--best .go-stat-row {
    color: #aaa;
  }

  .go-stat-row span:last-child {
    font-weight: 600;
    color: #555;
  }

  .go-card--best .go-stat-row span:last-child {
    color: #e0d8c8;
  }

  .go-ppm-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
  }

  .go-ppm-label {
    font-size: 13px;
    color: #999;
  }

  .go-card--best .go-ppm-label {
    color: #aaa;
  }

  .go-ppm-value {
    font-size: 20px;
    font-weight: 700;
    color: #555;
    font-family: 'Playfair Display', serif;
  }

  .go-ppm-value--best {
    font-size: 24px;
    color: var(--go-gold);
  }

  .go-saving {
    margin-top: 8px;
    font-size: 11.5px;
    color: var(--go-gold);
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 6px 10px;
    background: rgba(201, 168, 76, 0.1);
    border-radius: 8px;
    margin-bottom: 4px;
  }

  .go-btn {
    width: 100%;
    padding: 15px 20px;
    background: var(--go-dark);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    letter-spacing: 0.3px;
    transition: background 0.2s, transform 0.1s;
    margin-top: 18px;
  }

  .go-btn:hover {
    background: #333;
    transform: translateY(-1px);
  }

  .go-btn--best {
    background: linear-gradient(135deg, var(--go-gold), #ddb93e);
    color: #fff;
    box-shadow: 0 6px 20px rgba(201, 168, 76, 0.35);
  }

  .go-btn--best:hover {
    background: linear-gradient(135deg, #b8963e, #c9a84c);
  }

  .go-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 8, 5, 0.72);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    backdrop-filter: blur(4px);
  }

  .go-modal.active {
    display: flex;
  }

  .go-modal-box {
    background: #fff;
    border-radius: 20px;
    padding: 36px;
    max-width: 540px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.3);
  }

  .go-modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    background: #f5f0e8;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 16px;
    cursor: pointer;
    color: #888;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    padding: 0;
  }

  .go-modal-close:hover {
    background: #e8e0d5;
  }

  .go-modal-box h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    margin-bottom: 6px;
    margin-top: 0;
  }

  .go-modal-sub {
    color: #999;
    font-size: 14px;
    margin-bottom: 22px;
    margin-top: 0;
  }

  .go-scent-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }

  .go-scent-item {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 2px solid #eee;
    border-radius: 12px;
    padding: 14px 18px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    background: none;
  }

  .go-scent-item:has(input:checked) {
    border-color: var(--go-gold);
    background: #fdf9f0;
  }

  .go-scent-item--unavailable {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .go-scent-check {
    accent-color: var(--go-gold);
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .go-scent-check:disabled {
    cursor: not-allowed;
  }

  .go-scent-name {
    flex: 1;
    font-weight: 600;
    font-size: 14px;
  }

  .go-scent-variant {
    font-size: 12px;
    color: #bbb;
  }

  .go-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #eee;
    padding-top: 20px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .go-sel-count {
    font-size: 13px;
    color: #aaa;
  }

  .go-confirm-btn {
    background: linear-gradient(135deg, var(--go-gold), #ddb93e);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 13px 28px;
    font-size: 15px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    transition: opacity 0.2s, transform 0.1s;
    box-shadow: 0 4px 16px rgba(201, 168, 76, 0.3);
  }

  .go-confirm-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    box-shadow: none;
  }

  .go-confirm-btn:not(:disabled):hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .go-atc-error {
    color: #d32f2f;
    font-size: 13px;
    margin-top: 12px;
    padding: 8px 12px;
    background: rgba(211, 47, 47, 0.08);
    border-radius: 6px;
    border-left: 3px solid #d32f2f;
  }

  @media (max-width: 720px) {
    .great-offer-section .go-cards {
      grid-template-columns: 1fr;
    }

    .go-card--best {
      transform: none;
    }

    .go-card--best:hover {
      transform: translateY(-6px);
    }
  }
{% endstylesheet %}

{{ 'great-offer.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Great Offer Bundle",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "Limited Launch Promotion"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Great Offer"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Buy our bestselling perfumes and receive extra bottles completely free. Choose your size below."
    }
  ],
  "blocks": [
    {
      "type": "offer_card",
      "name": "Tier Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "size_label",
          "label": "Size label (e.g., '20 ml')",
          "default": "20 ml"
        },
        {
          "type": "text",
          "id": "size_option_value",
          "label": "Size option value (must match variant option)",
          "default": "20ml"
        },
        {
          "type": "number",
          "id": "qty_included",
          "label": "Quantity of bottles to select",
          "default": 2
        },
        {
          "type": "text",
          "id": "deal_tag_text",
          "label": "Deal tag text",
          "default": "Buy 1 Get 1 Free"
        },
        {
          "type": "text",
          "id": "per_ml_label",
          "label": "Per ml label",
          "default": "Per ml"
        },
        {
          "type": "text",
          "id": "per_ml_value",
          "label": "Per ml value (e.g., '£0.35')",
          "default": "£0.35"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button text",
          "default": "Choose your bottles →"
        }
      ]
    },
    {
      "type": "featured_offer_card",
      "name": "Featured Tier (Best Value)",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "size_label",
          "label": "Size label (e.g., '50 ml')",
          "default": "50 ml"
        },
        {
          "type": "text",
          "id": "size_option_value",
          "label": "Size option value (must match variant option)",
          "default": "50ml"
        },
        {
          "type": "number",
          "id": "qty_included",
          "label": "Quantity of bottles to select",
          "default": 3
        },
        {
          "type": "text",
          "id": "deal_tag_text",
          "label": "Deal tag text",
          "default": "Buy 1 Get 2 Free"
        },
        {
          "type": "text",
          "id": "per_ml_label",
          "label": "Per ml label",
          "default": "Per ml"
        },
        {
          "type": "text",
          "id": "per_ml_value",
          "label": "Per ml value (e.g., '£0.15')",
          "default": "£0.15"
        },
        {
          "type": "textarea",
          "id": "saving_text",
          "label": "Savings text (optional, e.g., '57% cheaper per ml than 20ml option')"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button text",
          "default": "Choose your bottles →"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Great Offer Bundle"
    }
  ]
}
{% endschema %}
