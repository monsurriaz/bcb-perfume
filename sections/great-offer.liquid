{%- comment -%}
  The Great Offer section enables customers to select from tiered bundle options,
  choose scents via a modal, and add multiple variant items to cart at once.
{%- endcomment -%}

<section class="great-offer-section">
  <div class="go-inner">
    <div class="go-header">
      {% if section.settings.eyebrow_text != blank %}
        <div class="go-eyebrow">{{ section.settings.eyebrow_text }}</div>
      {% endif %}
      <h2 class="go-title">{{ section.settings.title }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="go-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="go-cards">
      {%- for block in section.blocks -%}
        {%- assign block_products = block.settings.products -%}
        {%- assign size_option_value = block.settings.size_option_value -%}
        {%- assign qty = block.settings.qty_included -%}
        {%- assign is_featured = false -%}
        {%- if block.type == 'featured_offer_card' -%}
          {%- assign is_featured = true -%}
        {%- endif -%}

        {%- assign price_product = block_products | first -%}

        {%- if price_product -%}
          {%- comment -%} Find the variant matching this size {%- endcomment -%}
          {%- assign size_variant = nil -%}
          {%- for variant in price_product.variants -%}
            {%- if variant.option1 == size_option_value or variant.option2 == size_option_value or variant.option3 == size_option_value -%}
              {%- assign size_variant = variant -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if size_variant -%}
            {%- comment -%} Build scents array: block products × their size variant {%- endcomment -%}
            {%- assign scents_json_parts = '' -%}
            {%- for prod in block_products -%}
              {%- for var in prod.variants -%}
                {%- if var.option1 == size_option_value
                     or var.option2 == size_option_value
                     or var.option3 == size_option_value -%}
                  {%- unless scents_json_parts == '' -%}
                    {%- assign scents_json_parts = scents_json_parts | append: ',' -%}
                  {%- endunless -%}
                  {%- capture scent_obj -%}
                    {"id":{{ var.id }},"title":{{ prod.title | json }},"available":{{ var.available }},"image":"{{ var.featured_image | default: prod.featured_image | image_url: width: 100 }}"}
                  {%- endcapture -%}
                  {%- assign scents_json_parts = scents_json_parts | append: scent_obj -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}

            {%- assign scents_json = '[' | append: scents_json_parts | append: ']' -%}
            {%- assign card_image = block.settings.card_image | default: size_variant.featured_image | default: price_product.featured_image -%}
            {%- assign bottle_size_class = 'go-card-bottles--medium' -%}
            {%- if block.settings.size_label contains '20' -%}
              {%- assign bottle_size_class = 'go-card-bottles--small' -%}
            {%- elsif block.settings.size_label contains '50' -%}
              {%- assign bottle_size_class = 'go-card-bottles--large' -%}
            {%- endif -%}

            <div
              class="go-card{% if is_featured %} go-card--best{% endif %}"
              data-scents='{{ scents_json }}'
              data-qty="{{ qty }}"
              data-size-label="{{ block.settings.size_label }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <div class="go-card__inner">
                {%- if is_featured -%}
                  <div class="go-best-label">
                    <span class="go-best-text-desktop">{{ block.settings.best_value_text }}</span>
                    <span class="go-best-text-mobile">{{ block.settings.best_value_text_mobile }}</span>
                  </div>
                {%- endif -%}
  
                <div class="go-card-title">
                  <span>{{ block.settings.size_option_value }}</span>
                  <strong>{{ size_variant.price | money }}</strong>
                </div>
                <div class="go-deal-tag{% if is_featured %} go-deal-tag--big{% endif %}">
                  {{ block.settings.deal_tag_text }}
                </div>
  
                <div class="go-receive-line">
                  You receive <span>x{{ qty }} {{ block.settings.size_option_value }}</span> bottles
                </div>
  
                <div class="go-stat-row" hidden>
                  <span>Bottles included</span>
                  <span>× {{ qty }}</span>
                </div>
  
                <div class="go-card-bottles {{ bottle_size_class }}">
                  {%- if card_image != blank -%}
                    {%- for index in (1..qty) -%}
                      <img
                        class="go-card-bottle"
                        src="{{ card_image | image_url: width: 240 }}"
                        alt="{{ price_product.title | escape }} {{ block.settings.size_label | escape }} bottle"
                        loading="lazy"
                        width="120"
                        height="160"
                      >
                    {%- endfor -%}
                  {%- endif -%}
                </div>
  
                <div class="go-ppm-row">
                  <span class="go-ppm-label">{{ block.settings.per_ml_label }}</span>
                  <span class="go-ppm-value{% if is_featured %} go-ppm-value--best{% endif %}">
                    {{ block.settings.per_ml_value }}
                  </span>
                </div>
  
                <button
                  class="go-btn{% if is_featured %} go-btn--best{% endif %}"
                  type="button"
                  data-action="go-start-flow"
                >
                  <span class="go-btn-text">{{ block.settings.btn_text }}</span>
                  <span class="go-btn-mobile-text">{{ block.settings.btn_text_mobile }}</span>
                </button>
              </div>

              {%- if is_featured and block.settings.saving_text != blank -%}
                <div class="go-saving">{{ block.settings.saving_text }}</div>
              {%- endif -%}

            </div>
            
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Modal -->
    <div class="go-modal" id="go-modal">
      <div class="go-modal-box">
        <button class="go-modal-close" type="button" id="go-modal-close">✕</button>
        <h3 id="go-modal-title">Choose your bottles</h3>
        <p id="go-modal-subtitle" class="go-modal-sub"></p>

        <!-- Progress Bar -->
        <div class="go-progress-wrap">
          <div class="go-progress-label">
            <span>Bottles chosen</span>
            <span><strong id="go-progress-n">0</strong> / <strong id="go-progress-total">2</strong></span>
          </div>
          <div class="go-progress-bar-bg">
            <div class="go-progress-bar-fill" id="go-progress-fill"></div>
          </div>
        </div>

        <div class="go-scent-grid" id="go-scent-grid"></div>
        <div class="go-modal-footer">
          <span id="go-selection-count" class="go-sel-count">0 of 2 selected</span>
          <button class="go-confirm-btn" id="go-confirm-btn" type="button" disabled>
            Add to cart
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .great-offer-section * { box-sizing: border-box; margin: 0; padding: 0; }
  .great-offer-section {
    --go-gold: #c9a84c;
    --go-gold-light: #e8d499;
    --go-dark: #1a1a1a;
    --go-cream: #faf7f2;
    --go-radius: 18px;
    background: var(--go-cream);
    padding: 70px 24px 80px;
  }

  .go-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .go-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .go-header:not(:has(.go-subtitle)) {
    margin-bottom: clamp(48px, 5vw, 68px);
  }

  .go-eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--go-gold);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    margin-bottom: 14px;
  }

  .go-title {
    font-family: 'Playfair Display', serif;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(1.8rem, 5vw, 3.8rem);
    font-weight: 700;
    color: var(--go-dark);
    line-height: 1.1;
    margin-bottom: 14px;
  }

  .go-subtitle {
    font-size: 16px;
    color: #888;
    max-width: 440px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .go-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: center;
  }

  .go-card .go-card__inner {
    background: #fff;
    border-radius: var(--go-radius);
    border: 2px solid #e8e0d5;
    padding: 34px 26px 30px;
    text-align: center;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.25s;
  }

  .go-card:hover {
    
  }
  .go-card__inner:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
  }

  .go-card--best {
    
  }

  .go-card--best .go-card__inner {
    background: var(--go-dark);
    border: 2px solid var(--go-gold);
    color: #fff;
    padding-top: 44px;
    transform: scale(1.04);
    box-shadow: 0 20px 60px rgba(201, 168, 76, 0.22),
      0 4px 16px rgba(0, 0, 0, 0.18);
    z-index: 2;
  }

  .go-card--best:hover {
    
  }

  .go-card--best .go-card__inner {
    transform: scale(1.04) translateY(-6px);
    box-shadow: 0 28px 72px rgba(201, 168, 76, 0.28),
      0 4px 20px rgba(0, 0, 0, 0.22);
  }

  .go-best-label {
    position: absolute;
    top: -15px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, var(--go-gold), #e8c96a);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 5px 18px;
    border-radius: 20px;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(201, 168, 76, 0.4);
  }
  .go-best-text-mobile {
    display: none;
  }
  .go-best-text-desktop {
    display: inline-block;
  }

  .go-size-badge {
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--go-gold);
    font-weight: 600;
    margin-bottom: 10px;
  }

  .go-price {
    font-family: 'Playfair Display', serif;
    font-size: 2.8rem;
    font-weight: 700;
    color: inherit;
    line-height: 1;
    margin-bottom: 6px;
  }

  .go-card:not(.go-card--best) .go-price {
    color: var(--go-dark);
  }

  .go-deal-tag {
    display: inline-block;
    background: #f5f0e8;
    color: #9a8060;
    font-size: 13px;
    padding: 5px 14px;
    border-radius: 20px;
    font-weight: 500;
    margin-bottom: 14px;
  }

  .go-deal-tag--big {
    background: rgba(201, 168, 76, 0.15);
    color: var(--go-gold);
    font-weight: 700;
    font-size: 14px;
    border: 1px solid rgba(201, 168, 76, 0.3);
  }

  .go-divider {
    height: 1px;
    background: #f0ebe3;
    margin: 14px 0;
  }

  .go-card--best .go-divider {
    background: rgba(255, 255, 255, 0.1);
  }

  .go-stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    padding: 4px 0;
    color: #999;
  }

  .go-card--best .go-stat-row {
    color: #aaa;
  }

  .go-stat-row span:last-child {
    font-weight: 600;
    color: #555;
  }

  .go-card--best .go-stat-row span:last-child {
    color: #e0d8c8;
  }

  .go-ppm-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
  }

  .go-ppm-label {
    font-size: 13px;
    color: #999;
  }

  .go-card--best .go-ppm-label {
    color: #aaa;
  }

  .go-ppm-value {
    font-size: 20px;
    font-weight: 700;
    color: #555;
    font-family: 'Playfair Display', serif;
  }

  .go-ppm-value--best {
    font-size: 24px;
    color: var(--go-gold);
  }

  .go-saving {
    margin-top: 8px;
    font-size: 11.5px;
    color: var(--go-gold);
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 6px 10px;
    background: rgba(201, 168, 76, 0.1);
    border-radius: 8px;
    margin-bottom: 4px;
  }

  .go-btn {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 20px;
    background: var(--go-dark);
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 15px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    letter-spacing: 0.3px;
    transition: background 0.2s, transform 0.1s;
    margin-top: 18px;
  }

  .go-btn:hover {
    background: #333;
    transform: translateY(-1px);
  }

  .go-btn--best {
    background: linear-gradient(135deg, var(--go-gold), #ddb93e);
    color: #fff;
    box-shadow: 0 6px 20px rgba(201, 168, 76, 0.35);
  }

  .go-btn--best:hover {
    background: linear-gradient(135deg, #b8963e, #c9a84c);
  }

  .go-btn .go-btn-mobile-text {
    display: none;
  }

  .go-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 8, 5, 0.72);
    z-index: 9999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    backdrop-filter: blur(4px);
  }

  .go-modal.active {
    display: flex;
  }

  .go-modal-box {
    background: #fff;
    border-radius: 20px;
    padding: 36px;
    max-width: 540px;
    width: 100%;
    max-height: 88vh;
    overflow-y: auto;
    position: relative;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.3);
  }

  .go-modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    background: #f5f0e8;
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 16px;
    cursor: pointer;
    color: #888;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    padding: 0;
  }

  .go-modal-close:hover {
    background: #e8e0d5;
  }

  .go-modal-box h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    margin-bottom: 6px;
    margin-top: 0;
  }

  .go-modal-sub {
    color: #999;
    font-size: 14px;
    margin-bottom: 22px;
    margin-top: 0;
  }

  .go-progress-wrap {
    margin-bottom: 22px;
  }

  .go-progress-label {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: #aaa;
    margin-bottom: 8px;
  }

  .go-progress-label strong {
    color: var(--go-dark);
    font-weight: 700;
  }

  .go-progress-bar-bg {
    height: 6px;
    background: #f0ebe3;
    border-radius: 999px;
    overflow: hidden;
  }

  .go-progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--go-gold), #ddb93e);
    border-radius: 999px;
    transition: width 0.3s ease;
    width: 0%;
  }

  .go-scent-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }

  .go-scent-item {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 2px solid #eee;
    border-radius: 12px;
    padding: 14px 18px;
    transition: border-color 0.15s, background 0.15s;
    background: none;
  }

  .go-scent-item.has-qty {
    border-color: var(--go-gold);
    background: #fdf9f0;
  }

  .go-scent-item--unavailable {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .go-scent-image {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    object-fit: cover;
    object-position: center;
    flex-shrink: 0;
    border: 2px solid #f0ebe3;
    transition: border-color 0.15s, box-shadow 0.15s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .go-scent-item.has-qty .go-scent-image {
    border-color: var(--go-gold);
    box-shadow: 0 4px 12px rgba(201, 168, 76, 0.2);
  }

  .go-scent-info {
    flex: 1;
  }

  .go-scent-name {
    font-weight: 600;
    font-size: 14px;
  }

  .go-scent-variant {
    font-size: 12px;
    color: #bbb;
  }

  .go-stepper {
    display: flex;
    align-items: center;
    gap: 0;
    border: 1.5px solid #e0d8c8;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .go-stepper-btn {
    width: 34px;
    height: 34px;
    border: none;
    background: #f5f0e8;
    color: #666;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, color 0.15s;
    user-select: none;
    line-height: 1;
  }

  .go-stepper-btn:hover:not(:disabled) {
    background: var(--go-gold);
    color: #fff;
  }

  .go-stepper-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .go-stepper-val {
    width: 34px;
    text-align: center;
    font-size: 15px;
    font-weight: 700;
    color: var(--go-dark);
    background: #fff;
    border-left: 1.5px solid #e0d8c8;
    border-right: 1.5px solid #e0d8c8;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .go-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #eee;
    padding-top: 20px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .go-sel-count {
    font-size: 13px;
    color: #aaa;
  }

  .go-confirm-btn {
    background: linear-gradient(135deg, var(--go-gold), #ddb93e);
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 13px 28px;
    font-size: 15px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    transition: opacity 0.2s, transform 0.1s;
    box-shadow: 0 4px 16px rgba(201, 168, 76, 0.3);
  }

  .go-confirm-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    box-shadow: none;
  }

  .go-confirm-btn:not(:disabled):hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .go-atc-error {
    color: #d32f2f;
    font-size: 13px;
    margin-top: 12px;
    padding: 8px 12px;
    background: rgba(211, 47, 47, 0.08);
    border-radius: 6px;
    border-left: 3px solid #d32f2f;
  }

  @media (max-width: 720px) {
    .great-offer-section {
      padding-inline: 20px;
    }
    .great-offer-section .go-cards {
      gap: 10px;
    }
    .go-card--best:hover {
      transform: translateY(-6px);
    }

    .go-size-badge {
      font-size: 10px;
      letter-spacing: 1px;
      margin-bottom: 6px;
    }
    .go-price {
      font-size: 20px;
    }
    .go-deal-tag {
      font-size: 8px;
      padding: 3px 5px;
      border-radius: 20px;
      margin-bottom: 5px;
    }
    .go-divider {
      margin: 7px 0;
    }
    .go-stat-row {
      font-size: 8px;
      padding: 4px 0;
    }
    .go-stat-row span {
      display: inline-block;
      white-space: nowrap;
    }
    .go-ppm-row {
      margin-top: 5px;
    }
    .go-ppm-label {
      font-size: 11px;
    }
    .go-ppm-value {
      font-size: 15px;
    }
    .go-btn {
      width: 100%;
      padding: 10px 6px;
      border-radius: 6px;
      font-size: 11px;
      letter-spacing: .2px;
      margin-top: 12px;
    }
    .go-btn .go-btn-mobile-text {
      display: inline-block;
    }
    .go-btn .go-btn-text {
      display: none;
    }
    .go-best-label {
      top: -15px;
      font-size: 8px;
      letter-spacing: 1px;
      padding: 3px 6px;
    }
    .go-best-text-desktop {
      display: none;
    }
    .go-best-text-mobile {
      display: inline-block;
    }
    .go-saving {
      display: none;
      margin-top: 6px;
      font-size: 9px;
      letter-spacing: .3px;
      padding: 6px 6px;
      margin-bottom: 0px;
    }
    .go-modal-box {
      padding: 30px 25px 35px;
    }
    .go-scent-item {
      gap: 10px;
      padding: 14px 12px;
    }
    .go-scent-name {font-size: 12px; line-height: 1.4;}
    .go-stepper-btn {
      width: 26px;
      height: 30px;
      font-size: 16px;
    }
    .go-stepper-val {
      width: 30px;
      height: 30px;
      font-size: 13px;
    }
  }

  /* New CSS starts */
  .great-offer-section .go-cards {
    gap: 28px;
    align-items: stretch;
  }

  .great-offer-section .go-card {

  }

  .go-card.go-card--best {
    display: grid;
  }

  .great-offer-section .go-card .go-card__inner {
    border: 6px solid #e8e0d4;
    border-radius: 28px;
    padding: 32px 28px 28px;
    min-height: 510px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fff;
    color: #111;
    box-shadow: none;
    transform: none;
  }

  .great-offer-section .go-card .go-card__inner:hover,
  .great-offer-section .go-card--best .go-card__inner:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.07);
  }

  .great-offer-section .go-card--best {}

  .great-offer-section .go-card--best .go-card__inner {
    border-color: #e8e0d4;
    background: #fff;
    color: #111;
    padding-top: 32px;
    box-shadow: none;
    transform: none;
    position: relative;
  }

  .great-offer-section .go-best-label {
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    background: transparent;
    color: #050505;
    box-shadow: none;
    border-radius: 0;
    padding: 0;
    font-size: 20px;
    line-height: 1.1;
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0;
    text-transform: none;
  }

  .great-offer-section .go-card-title {
    order: 1;
    font-size: 25px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #050505;
    margin-bottom: 20px;
  }

  .great-offer-section .go-card-title span {
    font-weight: 400;
  }

  .great-offer-section .go-card-title strong {
    font-weight: 800;
  }

  .great-offer-section .go-deal-tag {
    order: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 45px;
    padding: 8px 20px;
    margin: 0 0 25px;
    border: 1.5px solid #ddd4c6;
    border-radius: 999px;
    background: #ede7dc;
    color: #7a7060;
    font-size: 18px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: 0;
  }

  .great-offer-section .go-deal-tag--big {
    background: #ef2418;
    border-color: #ef2418;
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
  }

  .great-offer-section .go-receive-line {
    order: 3;
    font-size: 18px;
    line-height: 1.25;
    font-weight: 800;
    color: #050505;
    margin-bottom: 25px;
    white-space: nowrap;
  }

  .great-offer-section .go-receive-line span {
    display: inline-block;
    font-weight: 900;
    font-size: 20px;
    color: #18ad18;
  }

  .great-offer-section .go-card-bottles {
    order: 4;
    min-height: 185px;
    width: 100%;
    max-width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin: auto 0 0;
    overflow: hidden;
  }

  .great-offer-section .go-card-bottle {
    display: block;
    flex: 0 1 auto;
    width: min(30%, 92px);
    max-width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center bottom;
    margin-inline: 2px;
  }

  .great-offer-section .go-card-bottles--small .go-card-bottle {
    width: min(29%, 72px);
    margin-inline: 4px;
  }

  .great-offer-section .go-card-bottles--medium .go-card-bottle {
    width: min(31%, 82px);
  }

  .great-offer-section .go-card-bottles--large .go-card-bottle {
    width: min(33%, 120px);
  }

  .great-offer-section .go-btn {
    order: 5;
    width: 100%;
    min-height: 60px;
    padding: 20px 24px;
    margin: 0 0 22px;
    border-radius: 999px;
    background: #050505;
    color: #fff;
    font-size: 20px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
    box-shadow: none;
  }

  .great-offer-section .go-btn:hover,
  .great-offer-section .go-btn--best:hover {
    background: #222;
    transform: none;
  }

  .great-offer-section .go-btn--best {
    background: #050505;
    color: #fff;
    box-shadow: none;
  }

  .great-offer-section .go-ppm-row {
    order: 6;
    justify-content: center;
    margin: 0;
  }

  .great-offer-section .go-ppm-label {
    display: none;
  }

  .great-offer-section .go-ppm-value,
  .great-offer-section .go-ppm-value--best {
    display: flex;
    font-family: inherit;
    font-size: 20px;
    line-height: 1;
    font-weight: 800;
    color: #050505;
  }

  .great-offer-section .go-ppm-value::after {
    content: "/ml";
    font-weight: 500;
  }

  .great-offer-section .go-saving {
    width: 100%;
    margin: 22px 0 0;
    padding: 0 10px;
    background: transparent;
    border-radius: 0;
    color: #ef2418;
    font-size: clamp(16px, 1.7vw, 21px);
    line-height: 1.15;
    font-weight: 500;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .great-offer-section .go-saving::before {
    content: "*";
    position: relative;
    top: -1.5px;
  }

  .great-offer-section .go-divider,
  .great-offer-section .go-stat-row {
    display: none;
  }

  @media (max-width: 990px) {
    .great-offer-section .go-cards {
      gap: 20px;
    }

    .great-offer-section .go-card .go-card__inner {
      min-height: 340px;
      padding: 28px 22px 24px;
    }

    .great-offer-section .go-card-title {
      font-size: 28px;
    }

    .great-offer-section .go-deal-tag {
      font-size: 16px;
      min-height: 44px;
      margin-bottom: 24px;
    }

    .great-offer-section .go-receive-line {
      font-size: 16px;
      white-space: normal;
    }

    .great-offer-section .go-receive-line span {
      font-size: 18px;
    }

    .great-offer-section .go-card-bottles--small .go-card-bottle {
      width: min(28%, 68px);
      margin-inline: 0 4px;
    }

    .great-offer-section .go-card-bottles--medium .go-card-bottle {
      width: min(30%, 76px);
    }

    .great-offer-section .go-card-bottles--large .go-card-bottle {
      width: min(32%, 82px);
    }

    .great-offer-section .go-btn {
      min-height: 62px;
      font-size: 22px;
    }

    .great-offer-section .go-ppm-value,
    .great-offer-section .go-ppm-value--best {
      font-size: 26px;
    }
  }

  @media (max-width: 720px) {
    .great-offer-section .go-cards {
      gap: 8px;
    }

    .great-offer-section .go-card {

    }
    
    .great-offer-section .go-card .go-card__inner {
      width: 100%;
      min-height: 0;
      border-radius: 14px;
      padding: 12px 8px;
      margin-inline: auto;
      border-width: 2px;
    }

    .great-offer-section .go-best-label {
      top: -22px;
      font-size: 13px;
    }

    .great-offer-section .go-card-title {
      font-size: 14px;
      margin-bottom: 16px;
    }

    .great-offer-section .go-deal-tag {
      font-size: 10px;
      margin-bottom: 16px;
      padding: 4px 8px;
      letter-spacing: -0.035rem;
      min-height: 30px;
      margin-inline: -5px;
    }

    .great-offer-section .go-receive-line {
      font-size: 12px;
      white-space: normal;
      margin-bottom: 10px;
      margin-inline: -5px;
      line-height: 1.6;
    }

    .great-offer-section .go-receive-line span {
      font-size: 12px;
    }

    .great-offer-section .go-card-bottles {
      min-height: 65px;
    }

    .great-offer-section .go-card-bottles--small .go-card-bottle {
      width: min(23%, 60px);
      margin-inline: 3px;
    }

    .great-offer-section .go-card-bottles--medium .go-card-bottle {
      width: min(27%, 80px);
      margin-inline: 1px;
    }

    .great-offer-section .go-card-bottles--large .go-card-bottle {
      width: min(35%, 100px);
      margin-inline: 0px;
    }

    .great-offer-section .go-btn {
      min-height: 32px;
      border-radius: 9px;
      font-size: 12px;
      padding: 8px 10px;
      margin-bottom: 12px;
    }

    .great-offer-section .go-ppm-value,
    .great-offer-section .go-ppm-value--best {
      font-size: 13px;
    }

    .great-offer-section .go-saving {
      display: block;
      font-size: 9px;
      margin: 5px 0 0;
      padding: 0px 5px;
    }
  }
{% endstylesheet %}

<script src="{{ 'great-offer.js' |  asset_url }}" defer></script>

